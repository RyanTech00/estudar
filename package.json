{
  "name": "estudar",
  "version": "1.2.0",
  "description": "Open-source study system built on learning science: AI weekly plan, focus mode, closed-book tests and a degree record. Runs locally or on your own Cloudflare + Supabase.",
  "keywords": [
    "study",
    "learning",
    "spaced-repetition",
    "retrieval-practice",
    "pomodoro",
    "pwa",
    "cloudflare-workers",
    "supabase",
    "estudo",
    "estudar"
  ],
  "homepage": "https://estudar.ryanbarbosa.com",
  "bugs": {
    "url": "https://github.com/RyanTech00/estudar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanTech00/estudar.git"
  },
  "funding": "https://buymeacoffee.com/ryanbarbosa",
  "license": "MIT",
  "author": "Ryan Barbosa",
  "type": "module",
  "bin": {
    "estudar": "setup/server.mjs"
  },
  "files": [
    "public/",
    "worker/",
    "setup/",
    "supabase/migrations/",
    "wrangler.jsonc",
    "README.pt-PT.md"
  ],
  "scripts": {
    "start": "node setup/server.mjs",
    "test": "node --test tests/",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "prepublishOnly": "npm test",
    "vendor": "node scripts/vendor-supabase.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "wrangler": "^4.73.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "esbuild": "0.28.1"
  }
}
